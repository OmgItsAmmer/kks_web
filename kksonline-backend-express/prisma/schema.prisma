// Prisma schema for KKS Online Backend
// Neon Postgres (pooled URL at runtime, direct URL for migrations). ERP/POS tables are not part of this schema.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Enums
enum Gender {
  male
  female
  other
}

enum ProductTag {
  CHOICE
  RECOMMENDED
  TRENDING
  hotSeller
  flashSale
  newArrival
  AUTHENTIC

  @@map("product_tags")
}

enum OrderStatus {
  pending
  ready
  confirmed
  cancelled
  delivered
  processing
  completed
}

enum PaymentMethod {
  cod
  credit_card
  bank_transfer
  pickup
  jazzcash
}

enum DiscountType {
  percentage
  fixed
}

enum SeverityLevel {
  info
  warning
  error
  critical
}

// Models
model Customer {
  customer_id  Int       @id @default(autoincrement())
  phone_number String?   @default("")
  first_name   String    @default("")
  last_name    String?   @default("")
  cnic         String?   @default("")
  email        String    @default("")
  created_at   DateTime? @default(now()) @db.Timestamptz()
  dob          DateTime? @db.Timestamptz()
  gender       Gender?
  auth_uid     String?   @unique
  fcm_token    String?

  addresses        Address[]
  order_addresses  OrderAddress[]
  cart             Cart[]
  orders           Order[]
  reviews          Review[]
  wishlist         Wishlist[]
  collection_carts CollectionCart[]

  @@map("customers")
}

model Category {
  category_id   Int       @id @default(autoincrement())
  category_name String
  isFeatured    Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamptz()
  product_count Int?

  products Product[]

  @@map("categories")
}

model Brand {
  brandID       Int      @id @default(autoincrement())
  brandname     String?
  isVerified    Boolean? @default(false)
  isFeatured    Boolean?
  product_count BigInt   @default(0)

  products Product[]

  @@map("brands")
}

model Product {
  product_id     Int         @id @default(autoincrement())
  name           String      @default("")
  description    String?     @default("")
  base_price     String?     @default("")
  sale_price     String?     @default("")
  category_id    Int?        @default(11)
  ispopular      Boolean?    @default(false)
  stock_quantity Int?        @default(0)
  created_at     DateTime?   @default(now()) @db.Timestamptz()
  brandID        Int?        @default(20)
  alert_stock    Int?
  isVisible      Boolean?    @default(false)
  tag            ProductTag?
  price_range    String?     @default("--")
  min_price      Decimal?    @db.Decimal(12, 2)
  max_price      Decimal?    @db.Decimal(12, 2)
  updated_at     DateTime?   @default(now()) @updatedAt @db.Timestamptz()

  category          Category?           @relation(fields: [category_id], references: [category_id])
  brand             Brand?              @relation(fields: [brandID], references: [brandID])
  variants          ProductVariant[]
  wishlist          Wishlist[]
  reviews           Review[]
  order_items       OrderItem[]
  product_discounts ProductDiscount[]
  notifications     Notification[]
  movements         InventoryMovement[]
  purchase_items    PurchaseItem[]

  @@index([category_id])
  @@index([brandID])
  @@index([isVisible])
  @@map("products")
}

model ProductVariant {
  variant_id   Int       @id @default(autoincrement())
  product_id   Int
  buy_price    Decimal   @db.Decimal
  sell_price   Decimal   @db.Decimal
  created_at   DateTime? @default(now()) @db.Timestamptz()
  updated_at   DateTime? @default(now()) @db.Timestamptz()
  sku          String?   @unique @db.VarChar
  variant_name String
  is_visible   Boolean?  @default(true)
  stock        Int?      @default(0)
  alert_stock  BigInt    @default(0)

  product                Product                @relation(fields: [product_id], references: [product_id])
  cart                   Cart[]
  inventory_reservations InventoryReservation[]
  movements              InventoryMovement[]
  purchase_items         PurchaseItem[]
  collection_items       CollectionItem[]
  collection_cart_items  CollectionCartItem[]

  @@map("product_variants")
}

model Cart {
  cart_id     Int    @id @default(autoincrement())
  variant_id  Int?
  quantity    String @default("")
  customer_id Int?

  variant  ProductVariant? @relation(fields: [variant_id], references: [variant_id])
  customer Customer?       @relation(fields: [customer_id], references: [customer_id])

  @@map("cart")
}

model Wishlist {
  wishlist_id BigInt   @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz()
  product_id  Int?
  customer_id Int?

  product  Product?  @relation(fields: [product_id], references: [product_id])
  customer Customer? @relation(fields: [customer_id], references: [customer_id])

  @@map("wishlist")
}

model Review {
  review_id   BigInt   @id @default(autoincrement())
  product_id  Int?
  sent_at     DateTime @default(now()) @db.Timestamptz()
  review      String?  @default("")
  rating      Decimal? @db.Decimal
  customer_id Int?
  is_hidden   Boolean  @default(false)

  product  Product?  @relation(fields: [product_id], references: [product_id])
  customer Customer? @relation(fields: [customer_id], references: [customer_id])

  @@index([product_id])
  @@map("reviews")
}

model Address {
  address_id        Int      @id @default(autoincrement())
  shipping_address  String?  @default("")
  phone_number      String?  @default("")
  postal_code       String?  @default("")
  city              String?  @default("")
  country           String?  @default("")
  full_name         String
  customer_id       Int?
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  place_id          String?
  formatted_address String?

  customer        Customer?      @relation(fields: [customer_id], references: [customer_id])
  orders          Order[]
  order_addresses OrderAddress[]

  @@map("addresses")
}

model OrderAddress {
  order_address_id  Int      @id @default(autoincrement())
  shipping_address  String?  @default("")
  phone_number      String?  @default("")
  postal_code       String?  @default("")
  city              String?  @default("")
  country           String?  @default("")
  full_name         String
  customer_id       Int?
  address_id        Int?
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  place_id          String?
  formatted_address String?

  customer Customer? @relation(fields: [customer_id], references: [customer_id])
  address  Address?  @relation(fields: [address_id], references: [address_id])

  @@map("order_addresses")
}

model Order {
  order_id             Int            @id @default(autoincrement())
  order_date           DateTime       @db.Date
  sub_total            Decimal        @db.Decimal
  status               OrderStatus
  address_id           Int?
  paid_amount          Decimal?       @db.Decimal
  buying_price         Decimal?       @db.Decimal
  discount             Decimal?       @default(0.0) @db.Decimal
  tax                  Decimal?       @default(0.0) @db.Decimal
  shipping_fee         Decimal?       @default(0.0) @db.Decimal
  customer_id          Int?
  idempotency_key      String?        @unique @db.VarChar
  payment_method       PaymentMethod? @default(cod)
  shipping_method      String?
  payment_receipt_path String?
  cancel_reason        String?
  cancelled_at         DateTime?      @db.Timestamptz()
  admin_note           String?
  created_at           DateTime       @default(now()) @db.Timestamptz()
  updated_at           DateTime       @default(now()) @updatedAt @db.Timestamptz()

  address        Address?             @relation(fields: [address_id], references: [address_id])
  customer       Customer?            @relation(fields: [customer_id], references: [customer_id])
  order_items    OrderItem[]
  notifications  Notification[]
  payments       OrderPayment[]
  status_history OrderStatusHistory[]

  @@index([status, order_date])
  @@index([customer_id])
  @@map("orders")
}

model OrderItem {
  product_id      Int
  price           Decimal   @db.Decimal
  quantity        Int
  order_id        Int
  unit            String?   @db.VarChar
  total_buy_price Decimal?  @default(0.0) @db.Decimal
  created_at      DateTime? @default(now()) @db.Timestamptz()
  variant_id      Int

  order   Order   @relation(fields: [order_id], references: [order_id])
  product Product @relation(fields: [product_id], references: [product_id])

  @@id([product_id, order_id, variant_id])
  @@index([order_id])
  @@map("order_items")
}

model Shop {
  shop_id                              Int      @id @default(autoincrement())
  shopname                             String
  taxrate                              Decimal  @db.Decimal
  shipping_price                       Decimal  @db.Decimal
  threshold_free_shipping              Decimal? @db.Decimal
  software_company_name                String?
  software_website_link                String?
  software_contact_no                  String?
  is_shipping_enable                   Boolean  @default(false)
  max_allowed_item_quantity            BigInt   @default(50)
  is_advance_payment_receipt_mandatory Boolean  @default(true)

  @@map("shop")
}

model Image {
  image_id   Int       @id @default(autoincrement())
  filename   String?
  created_at DateTime? @default(now()) @db.Timestamptz()
  image_url  String?
  folderType String?

  image_entities ImageEntity[]

  @@map("images")
}

model ImageEntity {
  image_entity_id Int       @id @default(autoincrement())
  image_id        Int?
  entity_id       Int?
  entity_category String?
  created_at      DateTime  @default(now()) @db.Timestamptz()
  isFeatured      Boolean?  @default(false)
  updated_at      DateTime? @default(now()) @db.Timestamptz()

  image Image? @relation(fields: [image_id], references: [image_id])

  @@map("image_entity")
}

model ProductDiscount {
  discount_id   Int          @id @default(autoincrement())
  product_id    Int
  discount_type DiscountType
  amount        Decimal      @db.Decimal
  start_date    DateTime     @db.Timestamptz()
  end_date      DateTime     @db.Timestamptz()
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamptz()

  product Product @relation(fields: [product_id], references: [product_id])

  @@map("product_discounts")
}

model InvoiceCoupon {
  coupon_id     Int          @id @default(autoincrement())
  title         String
  coupon_code   String       @unique
  discount_type DiscountType
  amount        Decimal      @db.Decimal
  usage_limit   Int?
  used_count    Int          @default(0)
  start_date    DateTime     @db.Timestamptz()
  end_date      DateTime     @db.Timestamptz()
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamptz()

  @@map("invoice_coupons")
}

model Notification {
  notification_id  Int       @id @default(autoincrement())
  created_at       DateTime  @default(now()) @db.Timestamptz()
  description      String?
  sub_description  String?
  isRead           Boolean?  @default(false)
  NotificationType String?
  expires_at       DateTime? @db.Timestamptz()
  order_id         Int?
  product_id       Int?

  order   Order?   @relation(fields: [order_id], references: [order_id])
  product Product? @relation(fields: [product_id], references: [product_id])

  @@index([isRead, created_at])
  @@map("notifications")
}

model InventoryReservation {
  reservation_id String    @db.VarChar
  variant_id     Int
  quantity       Int
  expires_at     DateTime  @db.Timestamptz()
  created_at     DateTime? @default(now()) @db.Timestamptz()

  variant ProductVariant @relation(fields: [variant_id], references: [variant_id])

  @@id([reservation_id, variant_id])
  @@map("inventory_reservations")
}

model SecurityAuditLog {
  log_id      Int            @id @default(autoincrement())
  event_type  String         @db.VarChar
  event_data  Json?
  timestamp   DateTime?      @default(now()) @db.Timestamptz()
  ip_address  String?        @db.Inet
  user_agent  String?
  customer_id Int?
  severity    SeverityLevel? @default(info)

  @@map("security_audit_log")
}

model AppVersion {
  id           BigInt    @id @default(autoincrement())
  version      String
  force_update Boolean   @default(false)
  redirect_url String
  description  String?
  created_at   DateTime? @default(now()) @db.Timestamptz()
  app_locked   Boolean   @default(false)

  @@map("app_versions")
}

enum PurchaseReceiptStatus {
  draft
  received
  cancelled
}

enum MovementReason {
  initial
  order_placed
  order_cancelled
  purchase_received
  purchase_reversed
  manual_adjustment
  correction
  return
}

/// Stock receipts (restock). Replaces vendor management: the supplier is just a name.
model Purchase {
  purchase_id    BigInt                @id @default(autoincrement())
  purchase_date  DateTime              @default(now()) @db.Date
  supplier_name  String?
  reference      String?
  note           String?
  receipt_status PurchaseReceiptStatus @default(draft)
  sub_total      Decimal               @default(0.00) @db.Decimal(12, 2)
  shipping_fee   Decimal               @default(0.00) @db.Decimal(12, 2)
  discount       Decimal               @default(0.00) @db.Decimal(12, 2)
  total          Decimal               @default(0.00) @db.Decimal(12, 2)
  received_at    DateTime?             @db.Timestamptz()
  created_by     String?
  created_at     DateTime              @default(now()) @db.Timestamptz()
  updated_at     DateTime              @default(now()) @updatedAt @db.Timestamptz()

  items PurchaseItem[]

  @@index([receipt_status, purchase_date])
  @@map("purchases")
}

model PurchaseItem {
  purchase_item_id BigInt   @id @default(autoincrement())
  purchase_id      BigInt
  product_id       Int
  variant_id       Int
  /// unit cost
  price            Decimal  @db.Decimal(12, 2)
  quantity         Int      @default(1)
  created_at       DateTime @default(now()) @db.Timestamptz()

  purchase Purchase       @relation(fields: [purchase_id], references: [purchase_id], onDelete: Cascade)
  product  Product        @relation(fields: [product_id], references: [product_id])
  variant  ProductVariant @relation(fields: [variant_id], references: [variant_id])

  @@index([purchase_id])
  @@map("purchase_items")
}

/// Ledger of every stock change. Written in the same transaction as the stock update.
model InventoryMovement {
  movement_id BigInt         @id @default(autoincrement())
  variant_id  Int
  product_id  Int
  delta       Int
  stock_after Int
  reason      MovementReason
  ref_type    String?
  ref_id      String?
  unit_cost   Decimal?       @db.Decimal(12, 2)
  note        String?
  actor       String?
  created_at  DateTime       @default(now()) @db.Timestamptz()

  variant ProductVariant @relation(fields: [variant_id], references: [variant_id])
  product Product        @relation(fields: [product_id], references: [product_id])

  @@index([variant_id, created_at])
  @@index([ref_type, ref_id])
  @@map("inventory_movements")
}

model OrderPayment {
  payment_id   BigInt        @id @default(autoincrement())
  order_id     Int
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  note         String?
  receipt_path String?
  received_by  String?
  created_at   DateTime      @default(now()) @db.Timestamptz()

  order Order @relation(fields: [order_id], references: [order_id])

  @@index([order_id])
  @@map("order_payments")
}

model AdminAuditLog {
  log_id         BigInt   @id @default(autoincrement())
  actor_admin_id String
  action         String
  entity_type    String?
  entity_id      String?
  before         Json?
  after          Json?
  ip_address     String?
  request_id     String?
  created_at     DateTime @default(now()) @db.Timestamptz()

  @@index([created_at])
  @@index([entity_type, entity_id])
  @@map("admin_audit_log")
}

model OrderStatusHistory {
  history_id  BigInt       @id @default(autoincrement())
  order_id    Int
  from_status OrderStatus?
  to_status   OrderStatus
  note        String?
  actor       String?
  created_at  DateTime     @default(now()) @db.Timestamptz()

  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id, created_at])
  @@map("order_status_history")
}

/// Bundles ("collections") shown on the storefront. These tables exist in the live database
/// but were never in the Prisma schema; the storefront reads them with raw SQL.
model Collection {
  collection_id Int      @id @default(autoincrement())
  name          String
  description   String?
  image_url     String?
  is_active     Boolean  @default(true)
  is_featured   Boolean  @default(false)
  is_premium    Boolean  @default(false)
  display_order Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz()

  items CollectionItem[]
  carts CollectionCart[]

  @@map("collections")
}

model CollectionItem {
  collection_item_id Int @id @default(autoincrement())
  collection_id      Int
  variant_id         Int
  default_quantity   Int @default(1)
  sort_order         Int @default(0)

  collection Collection     @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade)

  @@unique([collection_id, variant_id])
  @@map("collection_items")
}

model CollectionCart {
  collection_cart_id Int      @id @default(autoincrement())
  customer_id        Int
  collection_id      Int
  created_at         DateTime @default(now()) @db.Timestamptz()

  customer   Customer             @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  collection Collection           @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade)
  items      CollectionCartItem[]

  @@unique([customer_id, collection_id])
  @@map("collection_cart")
}

model CollectionCartItem {
  collection_cart_item_id Int @id @default(autoincrement())
  collection_cart_id      Int
  variant_id              Int
  quantity                Int @default(1)

  cart    CollectionCart @relation(fields: [collection_cart_id], references: [collection_cart_id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade)

  @@map("collection_cart_items")
}

/// One row per browser that turned on admin desktop alerts (Web Push).
model AdminPushSubscription {
  subscription_id Int       @id @default(autoincrement())
  admin_email     String
  endpoint        String    @unique
  p256dh          String
  auth            String
  user_agent      String?
  created_at      DateTime  @default(now()) @db.Timestamptz()
  last_success_at DateTime? @db.Timestamptz()

  @@index([admin_email])
  @@map("admin_push_subscriptions")
}
