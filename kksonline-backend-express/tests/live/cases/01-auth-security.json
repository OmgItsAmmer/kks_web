{
  "name": "Sign-in, sessions and access control",
  "cases": [
    { "id": "sec-001", "title": "health endpoint is up and needs no database", "readonly": true, "method": "GET", "path": "/health", "expect": { "status": 200, "json": { "status": "ok" } } },
    { "id": "sec-002", "title": "health/db reports the database connected", "readonly": true, "method": "GET", "path": "/health/db", "expect": { "status": 200, "json": { "database": "connected" } } },
    { "id": "sec-003", "title": "unknown route answers 404 JSON, not a stack trace", "readonly": true, "method": "GET", "path": "/definitely-not-a-route", "expect": { "status": 404, "json": { "success": false }, "headers": { "content-type": "json" } } },
    { "id": "sec-004", "title": "API sends security headers", "readonly": true, "method": "GET", "path": "/health", "expect": { "status": 200, "headers": { "x-content-type-options": "nosniff" } } },

    { "id": "sec-010", "title": "admin /me without a session is refused", "readonly": true, "method": "GET", "path": "/admin/auth/me", "expect": { "status": 401 } },
    { "id": "sec-011", "title": "anonymous GET /admin/products is refused", "readonly": true, "method": "GET", "path": "/admin/products", "expect": { "status": 401 } },
    { "id": "sec-012", "title": "anonymous GET /admin/orders is refused", "readonly": true, "method": "GET", "path": "/admin/orders", "expect": { "status": 401 } },
    { "id": "sec-013", "title": "anonymous GET /admin/customers is refused", "readonly": true, "method": "GET", "path": "/admin/customers", "expect": { "status": 401 } },
    { "id": "sec-014", "title": "anonymous GET /admin/reviews is refused", "readonly": true, "method": "GET", "path": "/admin/reviews", "expect": { "status": 401 } },
    { "id": "sec-015", "title": "anonymous GET /admin/inventory/stock is refused", "readonly": true, "method": "GET", "path": "/admin/inventory/stock", "expect": { "status": 401 } },
    { "id": "sec-016", "title": "anonymous GET /admin/inventory/movements is refused", "readonly": true, "method": "GET", "path": "/admin/inventory/movements", "expect": { "status": 401 } },
    { "id": "sec-017", "title": "anonymous GET /admin/inventory/receipts is refused", "readonly": true, "method": "GET", "path": "/admin/inventory/receipts", "expect": { "status": 401 } },
    { "id": "sec-018", "title": "anonymous GET /admin/collections is refused", "readonly": true, "method": "GET", "path": "/admin/collections", "expect": { "status": 401 } },
    { "id": "sec-019", "title": "anonymous GET /admin/categories is refused", "readonly": true, "method": "GET", "path": "/admin/categories", "expect": { "status": 401 } },
    { "id": "sec-020", "title": "anonymous GET /admin/brands is refused", "readonly": true, "method": "GET", "path": "/admin/brands", "expect": { "status": 401 } },
    { "id": "sec-021", "title": "anonymous GET /admin/dashboard is refused", "readonly": true, "method": "GET", "path": "/admin/dashboard", "expect": { "status": 401 } },
    { "id": "sec-022", "title": "anonymous GET /admin/reports/sales is refused", "readonly": true, "method": "GET", "path": "/admin/reports/sales", "expect": { "status": 401 } },
    { "id": "sec-023", "title": "anonymous GET /admin/settings/shop is refused", "readonly": true, "method": "GET", "path": "/admin/settings/shop", "expect": { "status": 401 } },
    { "id": "sec-024", "title": "anonymous GET /admin/settings/usage is refused", "readonly": true, "method": "GET", "path": "/admin/settings/usage", "expect": { "status": 401 } },
    { "id": "sec-025", "title": "anonymous GET /admin/audit is refused", "readonly": true, "method": "GET", "path": "/admin/audit", "expect": { "status": 401 } },
    { "id": "sec-026", "title": "anonymous GET /admin/notifications/latest is refused", "readonly": true, "method": "GET", "path": "/admin/notifications/latest", "expect": { "status": 401 } },
    { "id": "sec-027", "title": "anonymous POST /admin/products is refused (valid origin)", "readonly": true, "method": "POST", "path": "/admin/products", "body": { "name": "x", "variants": [] }, "expect": { "status": 401 } },
    { "id": "sec-028", "title": "anonymous order cancel is refused", "readonly": true, "method": "POST", "path": "/admin/orders/1/transition", "body": { "to": "cancelled" }, "expect": { "status": 401 } },
    { "id": "sec-029", "title": "anonymous stock adjustment is refused", "readonly": true, "method": "POST", "path": "/admin/inventory/adjustments", "body": { "variantId": 1, "mode": "delta", "value": 1, "note": "attack attack" }, "expect": { "status": 401 } },

    { "id": "sec-030", "title": "customer routes ignore the old X-Customer-Id header", "readonly": true, "method": "GET", "path": "/orders", "headers": { "X-Customer-Id": "1" }, "expect": { "status": 401 } },
    { "id": "sec-031", "title": "cart needs a customer token", "readonly": true, "method": "GET", "path": "/cart", "expect": { "status": 401 } },
    { "id": "sec-032", "title": "checkout needs a customer token", "readonly": true, "method": "POST", "path": "/orders/checkout", "body": { "directCheckout": { "variantId": 1, "quantity": 1, "price": 1 }, "addressId": 1, "shippingMethod": "pickup", "paymentMethod": "cod" }, "expect": { "status": 401 } },
    { "id": "sec-033", "title": "a garbage bearer token is refused", "readonly": true, "method": "GET", "path": "/orders", "headers": { "Authorization": "Bearer not.a.token" }, "expect": { "status": 401 } },
    { "id": "sec-034", "title": "private responses are never cacheable", "readonly": true, "method": "GET", "path": "/orders", "expect": { "status": 401, "headers": { "cache-control": "no-store" } } },
    { "id": "sec-035", "title": "internal jobs need the secret", "readonly": true, "method": "POST", "path": "/internal/jobs/release-reservations", "expect": { "status": [401, 403, 404] } },

    { "id": "sec-040", "title": "sign-in from a foreign origin is refused (CSRF)", "readonly": true, "method": "POST", "path": "/admin/auth/login", "headers": { "Origin": "https://evil.example" }, "body": { "email": "a@b.co", "password": "x" }, "expect": { "status": 403 } },
    { "id": "sec-041", "title": "wrong password gives a generic error", "readonly": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "nobody-{{runId}}@live-test.local", "password": "wrong-password-1" }, "expect": { "status": 401, "json": { "error": "Wrong email or password" } } },
    { "id": "sec-042", "title": "malformed email is rejected by validation", "readonly": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "not-an-email", "password": "x" }, "expect": { "status": [400, 422] } },
    { "id": "sec-043", "title": "missing password is rejected by validation", "readonly": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "a@b.co" }, "expect": { "status": [400, 422] } },
    { "id": "sec-044", "title": "SQL injection text in the email does not get through", "readonly": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "x' OR '1'='1", "password": "x" }, "expect": { "status": [400, 422] } },

    { "id": "sec-050", "title": "owner signs in", "readonly": true, "needsVar": "ownerPassword", "as": "owner", "captureCookie": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "{{ownerEmail}}", "password": "{{ownerPassword}}" }, "expect": { "status": 200, "json": { "data.role": "owner" }, "headers": { "set-cookie": "HttpOnly" } } },
    { "id": "sec-051", "title": "session cookie is Secure and SameSite=Lax", "readonly": true, "needsVar": "ownerPassword", "method": "POST", "path": "/admin/auth/login", "body": { "email": "{{ownerEmail}}", "password": "{{ownerPassword}}" }, "expect": { "status": 200, "headers": { "set-cookie": "Secure.*SameSite=Lax|SameSite=Lax.*Secure" } } },
    { "id": "sec-052", "title": "owner /me returns the signed-in account", "readonly": true, "needsActor": "owner", "as": "owner", "method": "GET", "path": "/admin/auth/me", "expect": { "status": 200, "json": { "data.email": "{{ownerEmail}}", "data.role": "owner" } } },
    { "id": "sec-053", "title": "admin responses are never cacheable", "readonly": true, "needsActor": "owner", "as": "owner", "method": "GET", "path": "/admin/products?pageSize=1", "expect": { "status": 200, "headers": { "cache-control": "no-store" } } },

    { "id": "sec-060", "title": "manager signs in", "as": "manager", "captureCookie": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "{{managerEmail}}", "password": "{{ownerPassword}}" }, "expect": { "status": 200, "json": { "data.role": "manager" } } },
    { "id": "sec-061", "title": "staff signs in", "as": "staff", "captureCookie": true, "method": "POST", "path": "/admin/auth/login", "body": { "email": "{{staffEmail}}", "password": "{{staffPassword}}" }, "expect": { "status": 200, "json": { "data.role": "staff" } } },
    { "id": "sec-062", "title": "staff /me shows the staff role", "as": "staff", "method": "GET", "path": "/admin/auth/me", "expect": { "status": 200, "json": { "data.role": "staff" } } },
    { "id": "sec-063", "title": "a write without any Origin header is refused (CSRF)", "as": "owner", "method": "POST", "path": "/admin/categories", "headers": { "Origin": "" }, "body": { "name": "no origin {{runId}}" }, "expect": { "status": 403 } },
    { "id": "sec-064", "title": "a write from a foreign origin is refused (CSRF)", "as": "owner", "method": "POST", "path": "/admin/categories", "headers": { "Origin": "https://evil.example" }, "body": { "name": "evil origin {{runId}}" }, "expect": { "status": 403 } },
    { "id": "sec-065", "title": "a forged session cookie is refused", "method": "GET", "path": "/admin/auth/me", "headers": { "Cookie": "kks_admin_session=eyJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6ImV2aWxAeC5jb20iLCJyb2xlIjoib3duZXIifQ.forged" }, "expect": { "status": 401 } },
    { "id": "sec-066", "title": "staff cannot read the audit log", "as": "staff", "method": "GET", "path": "/admin/audit", "expect": { "status": 403 } },
    { "id": "sec-067", "title": "staff cannot read shop settings", "as": "staff", "method": "GET", "path": "/admin/settings/shop", "expect": { "status": 403 } },
    { "id": "sec-068", "title": "manager cannot read shop settings (owner only)", "as": "manager", "method": "GET", "path": "/admin/settings/shop", "expect": { "status": 403 } },
    { "id": "sec-069", "title": "repeated wrong passwords get rate limited (429 on the 6th)", "method": "POST", "path": "/admin/auth/login", "repeat": 6, "repeatUntilStatus": 429, "body": { "email": "ratelimit-{{runId}}@live-test.local", "password": "wrong-password-1" }, "expect": { "status": 429 } }
  ]
}
