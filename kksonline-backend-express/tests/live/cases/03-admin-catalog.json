    {
      "id": "img-001",
      "title": "upload a picture: stored as WebP on the CDN",
      "as": "owner",
      "method": "POST",
      "path": "/admin/products/{{pid}}/images",
      "multipart": {
        "files": {
          "png": [
            900,
            600
          ]
        }
      },
      "save": {
        "imgEntityId": "data.images.0.imageEntityId",
        "imgUrl": "data.images.0.url"
      },
      "expect": {
        "status": 201,
        "json": {
          "data.images": {
            "$length": 1
          },
          "data.images.0.url": {
            "$regex": "\\.webp$"
          }
        }
      }
    },
    {
      "id": "img-002",
      "title": "the uploaded picture loads from the CDN",
      "method": "GET",
      "path": "{{imgUrl}}",
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "image/webp",
          "cache-control": "immutable"
        }
      }
    },
    {
      "id": "img-003",
      "title": "a fake image (script renamed .png) is refused",
      "as": "owner",
      "method": "POST",
      "path": "/admin/products/{{pid}}/images",
      "multipart": {
        "files": {
          "text": "<?php echo 1; ?>",
          "type": "image/png",
          "filename": "evil.png"
        }
      },
      "expect": {
        "status": 400
      }
    },
