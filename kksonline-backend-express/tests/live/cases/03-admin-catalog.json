      }
    },
    {
      "id": "adm-027",
      "title": "staff does not see the buy price",
      "as": "staff",
      "method": "GET",
      "path": "/admin/products/{{pid}}",
      "expect": {
        "status": 200,
        "json": {
          "data.variants.0.buyPrice": {
            "$exists": false
          }
        }
      }
    },
    {
      "id": "adm-028",
      "title": "owner sees the buy price",
      "as": "owner",
      "method": "GET",
      "path": "/admin/products/{{pid}}",
      "expect": {
        "status": 200,
        "json": {
          "data.variants.0.buyPrice": {
            "$exists": true
          }
        }
      }
    },
    {
      "id": "adm-029",
      "title": "stale edit is refused with 409",
      "as": "owner",
      "method": "PATCH",
      "path": "/admin/products/{{pid}}",
      "body": {
        "name": "LT Phone {{runId}}",
        "expectedUpdatedAt": "2020-01-01T00:00:00.000Z"
      },
      "expect": {
        "status": 409
      }
    },
    {
      "id": "adm-030",
      "title": "edit with the current timestamp works",
      "as": "owner",
      "method": "PATCH",
      "path": "/admin/products/{{pid}}",
      "body": {
        "description": "edited by live test",
        "expectedUpdatedAt": "{{pUpdated}}"
      },
      "save": {
        "pUpdated2": "data.updatedAt"
      },
      "expect": {
        "status": 200,
        "json": {
          "data.description": "edited by live test"
        }
      }
    },
    {
