{
  "name": "Admin: categories, brands, products, pictures",
  "cases": [
    {
      "id": "adm-000",
      "title": "STARTING INVARIANT: no variant has negative stock",
      "sql": [
        {
          "q": "select count(*)::int n from product_variants where stock < 0",
          "expect": {
            "rows.0.n": 0
          }
        }
      ]
    },
    {
      "id": "adm-001",
      "title": "STARTING INVARIANT: every variant's stock equals the sum of its ledger rows",
      "sql": [
        {
          "q": "select count(*)::int n from product_variants v where coalesce((select sum(m.delta) from inventory_movements m where m.variant_id = v.variant_id),0) <> coalesce(v.stock,0)",
          "expect": {
            "rows.0.n": 0
          }
        }
      ]
    },
    {
      "id": "adm-002",
      "title": "STARTING INVARIANT: product stock_quantity equals the sum of its variants",
      "sql": [
        {
          "q": "select count(*)::int n from products p where p.stock_quantity is distinct from (select coalesce(sum(v.stock),0) from product_variants v where v.product_id = p.product_id) and exists (select 1 from product_variants v where v.product_id = p.product_id)",
          "expect": {
            "rows.0.n": 0
          }
        }
      ]
    },
    {
      "id": "adm-010",
      "title": "create a category",
      "as": "owner",
      "method": "POST",
      "path": "/admin/categories",
      "body": {
        "name": "LT Category {{runId}}",
        "isFeatured": false
      },
      "save": {
        "catId": "data.id"
      },
      "expect": {
        "status": 201
      }
    },
    {
      "id": "adm-011",
      "title": "duplicate category name is refused",
      "as": "owner",
      "method": "POST",
      "path": "/admin/categories",
      "body": {
        "name": "LT Category {{runId}}"
      },
      "expect": {
        "status": [
          400,
          409
        ]
      }
    },
    {
      "id": "adm-012",
      "title": "staff cannot create a category",
      "as": "staff",
      "method": "POST",
      "path": "/admin/categories",
      "body": {
        "name": "staff cat {{runId}}"
      },
      "expect": {
        "status": 403
      }
    },
    {
      "id": "adm-013",
      "title": "category with an empty name is refused",
      "as": "owner",
      "method": "POST",
      "path": "/admin/categories",
      "body": {
        "name": "   "
      },
      "expect": {
        "status": [
          400,
          422
        ]
      }
    },
    {
      "id": "adm-014",
      "title": "category list shows product counts",
      "as": "staff",
      "method": "GET",
      "path": "/admin/categories",
      "expect": {
        "status": 200,
        "json": {
          "data.0.productCount": {
            "$exists": true
          }
        }
      }
    },
    {
      "id": "adm-015",
      "title": "create a brand",
      "as": "manager",
      "method": "POST",
      "path": "/admin/brands",
      "body": {
        "name": "LT Brand {{runId}}"
      },
      "save": {
        "brandId": "data.id"
      },
      "expect": {
        "status": 201
      }
    },
    {
      "id": "adm-020",
      "title": "create a product with two variants",
      "as": "owner",
      "method": "POST",
      "path": "/admin/products",
      "body": {
        "name": "LT Phone {{runId}}",
        "description": "live test",
        "categoryId": "{{catId}}",
        "brandId": "{{brandId}}",
        "isVisible": true,
        "variants": [
          {
            "variantName": "64GB",
            "sku": "LT-{{runId}}-A",
            "sellPrice": 1000,
            "buyPrice": 700,
            "stock": 10,
            "alertStock": 3
          },
          {
            "variantName": "128GB",
            "sku": "LT-{{runId}}-B",
            "sellPrice": "1500.50",
            "buyPrice": 900,
            "stock": 5,
            "alertStock": 2
          }
        ]
      },
      "save": {
        "pid": "data.id",
        "vA": "data.variants.0.id",
        "vB": "data.variants.1.id",
        "pUpdated": "data.updatedAt"
      },
      "expect": {
        "status": 201,
        "json": {
          "data.variants": {
            "$length": 2
          },
          "data.stockQuantity": 15
        }
      }
    },
    {
      "id": "adm-021",
      "title": "database: derived price range and stock total are right",
      "sql": [
        {
          "q": "select min_price::float mn, max_price::float mx, stock_quantity sq from products where product_id = $1",
          "args": [
            "{{pid}}"
          ],
          "expect": {
            "rows.0.mn": 1000,
            "rows.0.mx": 1500.5,
            "rows.0.sq": 15
          }
        }
      ]
    },
    {
      "id": "adm-022",
      "title": "database: opening stock is in the ledger for both variants",
      "sql": [
        {
          "q": "select count(*)::int n, sum(delta)::int s from inventory_movements where product_id = $1",
          "args": [
            "{{pid}}"
          ],
          "expect": {
            "rows.0.n": 2,
            "rows.0.s": 15
          }
        }
      ]
    },
    {
      "id": "adm-023",
      "title": "duplicate SKU is refused",
      "as": "owner",
      "method": "POST",
      "path": "/admin/products",
      "body": {
        "name": "LT dup sku {{runId}}",
        "categoryId": "{{catId}}",
        "brandId": "{{brandId}}",
        "variants": [
          {
            "variantName": "x",
            "sku": "LT-{{runId}}-A",
            "sellPrice": 5,
            "buyPrice": 1,
            "stock": 1
          }
        ]
