    {
      "id": "adm-026",
      "title": "staff cannot create products",
      "as": "staff",
      "method": "POST",
      "path": "/admin/products",
      "body": {
        "name": "LT staff {{runId}}",
        "categoryId": "{{catId}}",
        "brandId": "{{brandId}}",
        "variants": [
          {
            "variantName": "x",
            "sellPrice": 5,
            "buyPrice": 1,
