      "title": "the new product appears in the public shop",
      "method": "GET",
      "path": "/products?q=LT%20Phone%20{{runId}}",
      "expect": {
        "status": 200,
        "json": {
          "data": {
            "$length": 1
          }
        }
      }
    },
    {
