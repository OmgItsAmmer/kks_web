    {
      "id": "img-005",
      "title": "database: exactly one picture is linked to the product",
      "sql": [
        {
          "q": "select count(*)::int n from image_entity where entity_category = 'products' and entity_id = $1",
          "args": [
            "{{pid}}"
          ],
          "expect": {
            "rows.0.n": 1
          }
        }
      ]
    },
    {
      "id": "img-006",
      "title": "the product list now has its main picture",
      "method": "GET",
      "path": "/products?q=LT%20Phone%20{{runId}}",
      "expect": {
        "status": 200,
        "json": {
          "data.0.mainImage": {
            "$regex": "^https://"
          }
        }
      }
    }
