{
  "name": "Admin: processing orders end to end",
  "cases": [
    { "id": "flow-001", "title": "the new order shows up in the admin list", "as": "staff", "method": "GET", "path": "/admin/orders?q={{orderId}}", "expect": { "status": 200, "json": { "data.*.id": { "$contains": "{{orderId}}" } } } },
    { "id": "flow-002", "title": "the pending filter includes it", "as": "staff", "method": "GET", "path": "/admin/orders?status=pending&pageSize=100", "expect": { "status": 200, "json": { "data.*.id": { "$contains": "{{orderId}}" } } } },
    { "id": "flow-003", "title": "order detail: items, customer and totals", "as": "staff", "method": "GET", "path": "/admin/orders/{{orderId}}", "save": { "upd": "data.updatedAt" }, "expect": { "status": 200, "json": { "data.items": { "$length": 1 }, "data.status": "pending", "data.totals.amountPaid": { "$num": 0 } } } },
    { "id": "flow-004", "title": "staff do not see costs on the order", "as": "staff", "method": "GET", "path": "/admin/orders/{{orderId}}", "expect": { "status": 200, "json": { "data.items.0.totalBuyPrice": { "$exists": false }, "data.totals.cost": { "$exists": false } } } },
    { "id": "flow-005", "title": "owner sees the cost on the order", "as": "owner", "method": "GET", "path": "/admin/orders/{{orderId}}", "expect": { "status": 200, "json": { "data.totals.cost": { "$exists": true } } } },
    { "id": "flow-006", "title": "the admin has a notification about it", "as": "staff", "method": "GET", "path": "/admin/notifications", "expect": { "status": 200 } },
    { "id": "flow-007", "title": "notifications/latest gives a number for cheap polling", "as": "staff", "method": "GET", "path": "/admin/notifications/latest", "expect": { "status": 200, "json": { "data.latestId": { "$type": "number" } } } },

    { "id": "flow-010", "title": "cannot jump pending to completed", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "completed" }, "expect": { "status": 400 } },
    { "id": "flow-011", "title": "cannot go to an invented status", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "teleported" }, "expect": { "status": [400, 422] } },
    { "id": "flow-012", "title": "staff confirms the order", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "confirmed", "expectedUpdatedAt": "{{upd}}" }, "expect": { "status": 200, "json": { "data.status": "confirmed" } } },
    { "id": "flow-013", "title": "a stale screen is refused with 409", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "processing", "expectedUpdatedAt": "{{upd}}" }, "expect": { "status": 409 } },
    { "id": "flow-014", "title": "staff cannot cancel", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "cancelled", "note": "staff attempt" }, "expect": { "status": 403 } },
    { "id": "flow-015", "title": "staff cannot record payments", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/payments", "body": { "amount": 100, "method": "cod" }, "expect": { "status": 403 } },
    { "id": "flow-016", "title": "manager records an advance payment of 500", "as": "manager", "method": "POST", "path": "/admin/orders/{{orderId}}/payments", "body": { "amount": 500, "method": "cod", "note": "advance" }, "expect": { "status": 200, "json": { "data.totals.amountPaid": { "$num": 500 } } } },
    { "id": "flow-017", "title": "paying more than is owed is refused", "as": "manager", "method": "POST", "path": "/admin/orders/{{orderId}}/payments", "body": { "amount": 5000000, "method": "cod" }, "expect": { "status": 400 } },
    { "id": "flow-018", "title": "a zero or negative payment is refused", "as": "manager", "method": "POST", "path": "/admin/orders/{{orderId}}/payments", "body": { "amount": -5, "method": "cod" }, "expect": { "status": [400, 422] } },
    { "id": "flow-019", "title": "database: exactly one payment row of 500", "sql": [{ "q": "select count(*)::int n, sum(amount)::float s from order_payments where order_id = $1", "args": ["{{orderId}}"], "expect": { "rows.0.n": 1, "rows.0.s": 500 } }] },
    { "id": "flow-020", "title": "the balance is the total minus what was paid", "as": "staff", "method": "GET", "path": "/admin/orders/{{orderId}}", "expect": { "status": 200, "json": { "data.totals.amountPaid": { "$num": 500 } } } },

    { "id": "flow-030", "title": "move to processing", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "processing" }, "expect": { "status": 200, "json": { "data.status": "processing" } } },
    { "id": "flow-031", "title": "move to ready", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "ready" }, "expect": { "status": 200, "json": { "data.status": "ready" } } },
    { "id": "flow-032", "title": "move to delivered", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "delivered" }, "expect": { "status": 200, "json": { "data.status": "delivered" } } },
    { "id": "flow-033", "title": "cannot go back from delivered to pending", "as": "owner", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "pending" }, "expect": { "status": 400 } },
    { "id": "flow-034", "title": "complete the order", "as": "staff", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "completed" }, "expect": { "status": 200, "json": { "data.status": "completed" } } },
    { "id": "flow-035", "title": "a completed order cannot be cancelled", "as": "owner", "method": "POST", "path": "/admin/orders/{{orderId}}/transition", "body": { "to": "cancelled", "note": "too late" }, "expect": { "status": 400 } },
    { "id": "flow-036", "title": "a completed order cannot have its items edited", "as": "owner", "method": "PUT", "path": "/admin/orders/{{orderId}}/items", "body": { "items": [{ "variantId": "{{vA}}", "quantity": 1 }] }, "expect": { "status": [400, 409, 422] } },
    { "id": "flow-037", "title": "database: the status history has all the steps", "sql": [{ "q": "select count(*)::int n from order_status_history where order_id = $1", "args": ["{{orderId}}"], "expect": { "rows.0.n": { "$gte": 5 } } }] },
    { "id": "flow-038", "title": "database: the audit log recorded the actions", "sql": [{ "q": "select count(*)::int n from admin_audit_log where entity_id = $1::text and action ilike 'order%'", "args": ["{{orderId}}"], "expect": { "rows.0.n": { "$gte": 4 } } }] },
    { "id": "flow-039", "title": "database: finishing the order did not touch the stock (6)", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vA}}"], "expect": { "rows.0.stock": 6 } }] },

    { "id": "can-001", "title": "second order (cart checkout) is pending in the admin", "as": "staff", "method": "GET", "path": "/admin/orders/{{orderId2}}", "save": { "upd2": "data.updatedAt" }, "expect": { "status": 200, "json": { "data.status": "pending" } } },
    { "id": "can-002", "title": "edit items on a pending order: change 1 to 2 of the same variant", "as": "manager", "method": "PUT", "path": "/admin/orders/{{orderId2}}/items", "body": { "items": [{ "variantId": "{{vB}}", "quantity": 2 }], "expectedUpdatedAt": "{{upd2}}" }, "expect": { "status": 200 } },
    { "id": "can-003", "title": "database: the edit took one more from stock (4 to 3) and the total changed", "sql": [{ "q": "select (select stock from product_variants where variant_id = $1) s, (select sub_total::float from orders where order_id = $2) t", "args": ["{{vB}}", "{{orderId2}}"], "expect": { "rows.0.s": 3, "rows.0.t": 3001 } }] },
    { "id": "can-004", "title": "editing more than the stock is refused", "as": "manager", "method": "PUT", "path": "/admin/orders/{{orderId2}}/items", "body": { "items": [{ "variantId": "{{vB}}", "quantity": 99 }] }, "expect": { "status": [400, 409] } },
    { "id": "can-005", "title": "database: refused edit changed nothing", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vB}}"], "expect": { "rows.0.stock": 3 } }] },
    { "id": "can-006", "title": "manager cancels the order", "as": "manager", "method": "POST", "path": "/admin/orders/{{orderId2}}/transition", "body": { "to": "cancelled", "note": "live test cancel" }, "expect": { "status": 200, "json": { "data.status": "cancelled" } } },
    { "id": "can-007", "title": "database: cancelling put all 2 items back (stock 3 to 5)", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vB}}"], "expect": { "rows.0.stock": 5 } }] },
    { "id": "can-008", "title": "database: ledger has an order_cancelled row of +2", "sql": [{ "q": "select count(*)::int n from inventory_movements where variant_id = $1 and reason = 'order_cancelled' and delta = 2 and ref_id = $2::text", "args": ["{{vB}}", "{{orderId2}}"], "expect": { "rows.0.n": 1 } }] },
    { "id": "can-009", "title": "cancelling again is refused (no double restock)", "as": "manager", "method": "POST", "path": "/admin/orders/{{orderId2}}/transition", "body": { "to": "cancelled", "note": "again" }, "expect": { "status": 400 } },
    { "id": "can-010", "title": "database: stock is still 5 after the second cancel attempt", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vB}}"], "expect": { "rows.0.stock": 5 } }] },
    { "id": "can-011", "title": "a cancelled order cannot be reopened", "as": "owner", "method": "POST", "path": "/admin/orders/{{orderId2}}/transition", "body": { "to": "confirmed" }, "expect": { "status": 400 } },
    { "id": "can-012", "title": "cancel with the same request sent in parallel restocks exactly once", "as": "owner", "method": "GET", "path": "/admin/orders/{{orderId2}}", "expect": { "status": 200, "json": { "data.status": "cancelled" } } },
    { "id": "can-013", "title": "the customer sees the cancelled status", "as": "cust3", "method": "GET", "path": "/orders/{{orderId2}}", "expect": { "status": 200 } },

    { "id": "can-020", "title": "set up: a third order to cancel from two requests at once", "as": "cust4", "method": "POST", "path": "/orders/checkout", "body": { "directCheckout": { "variantId": "{{vM}}", "quantity": 4, "price": 200 }, "addressId": "{{addrIds.3}}", "shippingMethod": "pickup", "paymentMethod": "cod", "idempotencyKey": "lt-{{runId}}-order4" }, "save": { "orderId4": "data.orderId" }, "expect": { "status": [200, 201] } },
    { "id": "can-021", "title": "database: stock for Misc is 496", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vM}}"], "expect": { "rows.0.stock": 496 } }] },
    { "id": "can-022", "title": "two cancel requests at the same moment: one wins, none double-restock", "as": "owner", "burst": { "count": 2, "as": "owner" }, "method": "POST", "path": "/admin/orders/{{orderId4}}/transition", "body": { "to": "cancelled", "note": "parallel cancel" }, "expect": { "statusCounts": { "200": 1 }, "statusOnly": [200, 400, 409] } },
    { "id": "can-023", "title": "database: Misc stock is exactly 500 again (restocked once, not twice)", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vM}}"], "expect": { "rows.0.stock": 500 } }] },

    { "id": "can-030", "title": "set up: a pending order the customer will cancel themselves", "as": "cust4", "method": "POST", "path": "/orders/checkout", "body": { "directCheckout": { "variantId": "{{vM}}", "quantity": 3, "price": 200 }, "addressId": "{{addrIds.3}}", "shippingMethod": "pickup", "paymentMethod": "cod", "idempotencyKey": "lt-{{runId}}-order5" }, "save": { "orderId5": "data.orderId" }, "expect": { "status": [200, 201] } },
    { "id": "can-031", "title": "database: Misc stock is 497 after the order", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vM}}"], "expect": { "rows.0.stock": 497 } }] },
    { "id": "can-032", "title": "another customer cannot cancel it", "as": "cust3", "method": "POST", "path": "/orders/{{orderId5}}/cancel", "expect": { "status": 403 } },
    { "id": "can-033", "title": "customer double-clicks cancel: one wins, the other is refused", "as": "cust4", "burst": { "count": 2, "as": "cust4" }, "method": "POST", "path": "/orders/{{orderId5}}/cancel", "expect": { "statusCounts": { "200": 1 }, "statusOnly": [200, 400] } },
    { "id": "can-034", "title": "database: customer cancel returned the stock exactly once (back to 500)", "sql": [{ "q": "select stock from product_variants where variant_id = $1", "args": ["{{vM}}"], "expect": { "rows.0.stock": 500 } }] },
    { "id": "can-035", "title": "database: ledger has one order_cancelled row of +3 for it", "sql": [{ "q": "select count(*)::int n from inventory_movements where variant_id = $1 and reason = 'order_cancelled' and delta = 3 and ref_id = $2::text", "args": ["{{vM}}", "{{orderId5}}"], "expect": { "rows.0.n": 1 } }] },
    { "id": "can-036", "title": "database: cancel time, status history and admin notification are recorded", "sql": [
      { "q": "select count(*)::int n from orders where order_id = $1 and status = 'cancelled' and cancelled_at is not null", "args": ["{{orderId5}}"], "expect": { "rows.0.n": 1 } },
      { "q": "select count(*)::int n from order_status_history where order_id = $1 and to_status = 'cancelled' and actor like 'customer:%'", "args": ["{{orderId5}}"], "expect": { "rows.0.n": 1 } },
      { "q": "select count(*)::int n from notifications where order_id = $1 and \"NotificationType\" = 'order_cancelled'", "args": ["{{orderId5}}"], "expect": { "rows.0.n": 1 } }
    ] },
    { "id": "can-037", "title": "the admin cannot move a customer-cancelled order on", "as": "owner", "method": "POST", "path": "/admin/orders/{{orderId5}}/transition", "body": { "to": "confirmed" }, "expect": { "status": 400 } }
  ]
}
