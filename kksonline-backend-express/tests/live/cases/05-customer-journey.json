        "variantId": "{{vB}}",
        "quantity": 1
      },
      "expect": {
        "status": [
          200,
          201
        ]
      }
    },
    {
      "id": "ord-021",
      "title": "cart checkout places the order",
      "as": "cust3",
      "method": "POST",
      "path": "/orders/checkout",
      "body": {
        "cartItems": [
          {
            "variantId": "{{vB}}",
            "quantity": 1,
            "sellPrice": 1500.5
          }
        ],
        "addressId": "{{addrIds.2}}",
        "shippingMethod": "pickup",
        "paymentMethod": "cod",
        "idempotencyKey": "lt-{{runId}}-order2"
      },
      "save": {
        "orderId2": "data.orderId"
      },
      "expect": {
        "status": [
          200,
          201
        ],
        "json": {
          "data.orderId": {
            "$gt": 0
          }
        }
      }
    },
    {
      "id": "ord-022",
      "title": "database: the cart was cleared and stock dropped 5 to 4",
      "sql": [
        {
          "q": "select (select count(*)::int from cart where customer_id = $1) c, (select stock from product_variants where variant_id = $2) s",
          "args": [
            "{{custIds.2}}",
            "{{vB}}"
          ],
          "expect": {
            "rows.0.c": 0,
            "rows.0.s": 4
          }
        }
      ]
    },
    {
      "id": "ord-023",
      "title": "ordering more than what is left is refused",
      "as": "cust3",
      "method": "POST",
      "path": "/orders/checkout",
      "body": {
        "directCheckout": {
          "variantId": "{{vB}}",
          "quantity": 5,
          "price": 1500.5
        },
        "addressId": "{{addrIds.2}}",
        "shippingMethod": "pickup",
        "paymentMethod": "cod",
        "idempotencyKey": "lt-{{runId}}-order3"
      },
      "expect": {
        "status": 400
      }
    },
    {
      "id": "ord-024",
      "title": "database: refused order left stock at 4",
      "sql": [
        {
          "q": "select stock from product_variants where variant_id = $1",
          "args": [
            "{{vB}}"
          ],
          "expect": {
            "rows.0.stock": 4
          }
        }
      ]
    },
    {
      "id": "ord-025",
      "title": "the order total adds up: subtotal + tax",
      "sql": [
        {
          "q": "select (sub_total + coalesce(tax,0) + coalesce(shipping_fee,0) - coalesce(discount,0))::float t, sub_total::float s from orders where order_id = $1",
          "args": [
            "{{orderId2}}"
          ],
          "expect": {
            "rows.0.s": 1500.5,
            "rows.0.t": {
              "$approx": [
                1500.5,
                1000000
              ]
            }
          }
        }
      ]
    },
