# Copy to `.env.development` or `.env.local`. Never commit real env files.
# See runbooks/01-secrets.md and docs/env-files.md
#
# Precedence (first-wins):
#   1. Process environment (Fly secrets / system env / test setup)
#   2. .env.<APP_ENV>.local
#   3. .env.local (machine overrides)
#   4. .env.<APP_ENV> (.env.development, .env.production)
#   5. Root .env.local (written by Neon CLI with DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH)

# ---------------------------------------------------------------- Server [needed now]
NODE_ENV=development
APP_ENV=development
PORT=5000
API_VERSION=v1

# ---------------------------------------------------------------- Database: Neon [needed now]
# Neon CLI (`neon deploy`, `neon checkout dev`) writes DATABASE_URL, DATABASE_URL_UNPOOLED
# and NEON_BRANCH to the repository root `../.env.local`.
# Leave them unset here so `neon checkout <branch>` continues switching branches seamlessly!
# Runbook: runbooks/02-neon.md
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Read-only key for the daily free-plan usage check (Phase 2)
NEON_API_KEY=

# ---------------------------------------------------------------- Auth (storefront customers) [needed now]
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
GOOGLE_CLIENT_ID=your_google_client_id

# ---------------------------------------------------------------- Supabase (REMOVED AT CUTOVER, Phase 11)
# Temporary variables used during migration from the legacy project.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_DATABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=ap-southeast-1

# ---------------------------------------------------------------- Images: Cloudflare R2 (Phase 2)
# Runbook: runbooks/05-cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=kks-public
R2_PRIVATE_BUCKET=kks-private
# Public image address, no trailing slash
ASSET_BASE_URL=https://cdn.kks-online.com

# ---------------------------------------------------------------- Cloudflare cache purge (Phase 2)
# Runbooks: runbooks/03-cloudflare-domain.md, runbooks/04-cloudflare-api-token.md
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------- Admin sign-in (Plan Phase 5.1)
# ADMIN_ACCOUNTS: Single-line JSON array of admin user objects.
# Passwords must be bcrypt hashes ($2b$...). Keep single-line; do NOT expand $.
# Generate hashes using: npm run admin:hash
ADMIN_ACCOUNTS=
# Long random string (min 32 characters)
ADMIN_SESSION_SECRET=
ADMIN_ORIGIN=http://localhost:5174
COOKIE_DOMAIN=

# ---------------------------------------------------------------- AI descriptions: OpenAI (Phase 6)
# Runbook: runbooks/07-openai.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT_PER_ADMIN=300

# ---------------------------------------------------------------- Scheduled jobs (Phase 2)
# Long random text. The same value goes in GitHub Actions secrets (runbooks/12-github-secrets.md)
JOBS_SECRET=

# ---------------------------------------------------------------- Monitoring (optional, free plan)
SENTRY_DSN=

# ---------------------------------------------------------------- Limits and CORS [needed now]
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CACHE_TTL_SECONDS=1800
