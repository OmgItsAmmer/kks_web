# Copy to `.env` (this folder). Never commit `.env`. See runbooks/01-secrets.md
# Items marked [needed now] are read by the current code. The rest are used by
# the rebuild phases in plan.md and are listed so setup can be done early.

# ---------------------------------------------------------------- Server [needed now]
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ---------------------------------------------------------------- Database: Neon [needed now]
# `neon deploy` writes both of these to ../.env.local (the app loads that file too).
# DATABASE_URL          pooled connection string (runtime, host contains "-pooler")
# DATABASE_URL_UNPOOLED direct connection string (Prisma migrate only)
# Runbook: runbooks/02-neon.md
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Read-only key for the daily free-plan usage check (Phase 2)
NEON_API_KEY=

# ---------------------------------------------------------------- Auth (storefront customers) [needed now]
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
GOOGLE_CLIENT_ID=your_google_client_id

# ---------------------------------------------------------------- Supabase (REMOVED AT CUTOVER, Phase 11)
# Still required by the current code, and used by the migration scripts to read the
# old project. Delete these once nothing references Supabase.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Read-only connection string for the migration dump (runbooks/11-supabase-steps.md)
SUPABASE_DATABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=ap-southeast-1

# ---------------------------------------------------------------- Images: Cloudflare R2 (Phase 2)
# Runbook: runbooks/05-cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=kks-public
R2_PRIVATE_BUCKET=kks-private
# Public image address, no trailing slash
ASSET_BASE_URL=https://cdn.example.com

# ---------------------------------------------------------------- Cloudflare cache purge (Phase 2)
# Runbooks: runbooks/03-cloudflare-domain.md, runbooks/04-cloudflare-api-token.md
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------- Admin login: Better Auth (Phase 3)
# BETTER_AUTH_SECRET: long random text, different from JWT_SECRET
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
ADMIN_ORIGIN=http://localhost:5174
# Parent domain for the login cookie in production (for example .example.com). Leave empty locally.
COOKIE_DOMAIN=
ADMIN_REQUIRE_2FA_ROLES=owner
# First owner account, used on first run only. The password must be changed at first login.
# Runbook: runbooks/10-admin-accounts.md
ADMIN_SEED_OWNER_EMAIL=
ADMIN_SEED_OWNER_PASSWORD=

# ---------------------------------------------------------------- Admin email: Resend (Phase 3)
# Runbook: runbooks/08-resend-email.md
RESEND_API_KEY=
MAIL_FROM=KKS Admin <no-reply@example.com>

# ---------------------------------------------------------------- AI descriptions: OpenAI (Phase 6)
# Runbook: runbooks/07-openai.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT_PER_ADMIN=300

# ---------------------------------------------------------------- Scheduled jobs (Phase 2)
# Long random text. The same value goes in GitHub Actions secrets (runbooks/12-github-secrets.md)
JOBS_SECRET=

# ---------------------------------------------------------------- Monitoring (optional, free plan)
SENTRY_DSN=

# ---------------------------------------------------------------- Limits and CORS [needed now]
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CACHE_TTL_SECONDS=1800
