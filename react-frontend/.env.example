# Copy to `.env.local` or `.env.development`.
# The values below end up inside the public client website, so NEVER put private keys or secrets here.
#
# Production values are set in Cloudflare Pages project settings (runbooks/06-cloudflare-pages.md).

# API address (WITHOUT trailing /api/v1 - the client appends /api/v1).
# Development: http://localhost:5000
# Production: https://api.kks-online.com
VITE_API_BASE_URL=http://localhost:5000

# Public image address (Cloudflare R2 custom domain).
# Production: https://cdn.kks-online.com
VITE_ASSET_BASE_URL=https://cdn.kks-online.com

# Google OAuth Client ID (public by design)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# LocationIQ API Key (for address geocoding; browser client key, restrict by HTTP referer in LocationIQ dashboard)
# Get from: https://locationiq.com/
VITE_LOCATIONIQ_API_KEY=your_locationiq_api_key_here
