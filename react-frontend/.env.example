# Copy to `.env.local` (not `.env`, which is tracked in git). The values below end up
# inside the public website, so NEVER put a private key here.

# API address (include no trailing slash). Production: https://api.example.com
VITE_API_BASE_URL=http://localhost:5000

# Public image address (Cloudflare R2 custom domain). Production: https://cdn.example.com
# Until the Phase 11 cutover, old Supabase image URLs also keep working.
VITE_ASSET_BASE_URL=https://cdn.example.com

# Google OAuth Client ID (public by design)
# Get this from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# LocationIQ API Key (for address geocoding; shipped to the browser, so restrict it by domain)
# Get free key from: https://locationiq.com/
VITE_LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Cloudflare Pages: set these same variables in the project settings, plus NODE_VERSION=22
# (runbooks/06-cloudflare-pages.md)
