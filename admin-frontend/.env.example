# Copy to `.env.local` or `.env.development`.
# Note: Values here are embedded into the client bundle and are PUBLIC.
# NEVER put private keys or secrets here.

# API Base URL (must INCLUDE /api/v1):
#   Development (via Vite proxy): /api/v1
#   Production (Cloudflare Pages): https://api.kks-online.com/api/v1
VITE_API_BASE_URL=/api/v1

# Dev proxy target (used by vite.config.ts in dev server mode only):
VITE_DEV_API_TARGET=http://localhost:5000

# Public image address (Cloudflare R2 custom domain):
VITE_ASSET_BASE_URL=https://cdn.kks-online.com

